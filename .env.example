# Copy this file to .env and fill in real values. .env is git-ignored.
# Get a key at https://build.nvidia.com (log in, open a Nemotron model, "View Code", generate key)
NVIDIA_API_KEY=
# Optional overrides
# If you get a 404 "Not found for account", your key can't use that model: try another Nemotron id
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
